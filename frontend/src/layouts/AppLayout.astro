---
import BaseLayout from './BaseLayout.astro';

interface Props {
  titulo: string;
  encabezado: string;
  bajada?: string;
  /**
   * Cuánto ancho puede ocupar la pantalla en un monitor.
   *
   *   'ancho'   → hasta 72rem. Para lo que se organiza en rejilla: el
   *               calendario, los perfiles, el panel de administración.
   *   'lectura' → hasta 42rem. Para lo que es UNA columna de texto —una
   *               pregunta, un dilema—. Estirar eso a todo el monitor da
   *               líneas de treinta palabras que nadie lee de un tirón: el
   *               ojo pierde el renglón al volver a la izquierda.
   *
   * En teléfono los dos valen lo mismo. El ancho extra solo aparece a partir
   * de `sm`, así que el formato de móvil se queda exactamente como estaba.
   */
  ancho?: 'ancho' | 'lectura';
}

const { titulo, encabezado, bajada, ancho = 'ancho' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ANCHOS = {
  ancho: 'max-w-md sm:max-w-3xl lg:max-w-6xl',
  lectura: 'max-w-md sm:max-w-2xl',
} as const;
---

<BaseLayout titulo={titulo}>
  {/* Mientras el guardia decide, no se enseña nada: evita el parpadeo de
      contenido vacío antes de saber si este dispositivo está vinculado. */}
  <div id="guardia" class="flex min-h-dvh items-center justify-center">
    <span class="h-6 w-6 animate-spin rounded-full border-2 border-borde border-t-acento"></span>
    <span class="sr-only">Cargando</span>
  </div>

  <div id="app" class={`mx-auto hidden px-5 pt-6 pb-20 sm:px-8 ${ANCHOS[ancho]}`}>
    <header class="mb-6">
      <a
        href={`${base}/inicio`}
        class="-ml-1 inline-flex items-center gap-1.5 rounded-lg px-1 py-1 text-sm text-tinta-suave transition hover:text-acento"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Inicio
      </a>
      <div class="mt-2 flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h1 class="text-2xl font-semibold text-tinta">{encabezado}</h1>
          {bajada && <p class="mt-1 text-sm text-tinta-suave">{bajada}</p>}
        </div>
        <button
          id="btn-tema"
          type="button"
          class="shrink-0 rounded-xl border border-borde px-3 py-2 text-lg leading-none transition hover:bg-superficie-alt"
        >🌗</button>
      </div>
    </header>

    <slot />
  </div>
</BaseLayout>

<script>
  import { montarBotonTema } from '../domain/tema/tema';

  // El botón vive en el layout, así que está en todas las pantallas sin que
  // cada una tenga que acordarse de ponerlo.
  const boton = document.getElementById('btn-tema');
  if (boton) montarBotonTema(boton);
</script>
