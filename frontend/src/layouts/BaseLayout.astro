---
import '../styles/global.css';
import { POLITICA_CSP } from '../config/csp';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Nuestro espacio' } = Astro.props;

// La política vive en config/csp.ts, donde está documentada y cubierta por
// tests. Solo se emite en producción: en desarrollo rompería el HMR de Vite,
// que necesita un WebSocket a localhost y evaluación dinámica.
const csp = POLITICA_CSP;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    {/* App privada: fuera de los buscadores. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta name="theme-color" content="#fdf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191416" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>

  <body class="min-h-dvh antialiased">
    <slot />
  </body>
</html>
