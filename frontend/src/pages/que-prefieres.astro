---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout
  titulo="Qué prefieres · Nuestro Espacio"
  encabezado="¿Qué prefieres?"
  bajada="Votan a ciegas. Se revela solo cuando los dos han elegido."
  ancho="lectura"
>
  <section class="flex flex-col gap-3">
    <button
      id="opcion-A"
      type="button"
      data-opcion="A"
      class="tarjeta group relative flex min-h-28 items-center justify-center px-6 py-6 text-center transition hover:border-acento active:scale-[0.99] disabled:active:scale-100"
    >
      <span id="texto-A" class="text-lg font-medium text-balance text-tinta">…</span>
      <span id="marca-A" class="absolute top-3 right-3 hidden text-xs font-semibold"></span>
    </button>

    <div class="flex items-center gap-3" aria-hidden="true">
      <span class="h-px flex-1 bg-borde"></span>
      <span class="text-xs font-semibold tracking-wide text-tinta-tenue uppercase">o</span>
      <span class="h-px flex-1 bg-borde"></span>
    </div>

    <button
      id="opcion-B"
      type="button"
      data-opcion="B"
      class="tarjeta group relative flex min-h-28 items-center justify-center px-6 py-6 text-center transition hover:border-acento active:scale-[0.99] disabled:active:scale-100"
    >
      <span id="texto-B" class="text-lg font-medium text-balance text-tinta">…</span>
      <span id="marca-B" class="absolute top-3 right-3 hidden text-xs font-semibold"></span>
    </button>
  </section>

  <div
    id="estado"
    role="status"
    aria-live="polite"
    class="mt-5 rounded-xl bg-superficie-alt px-4 py-3.5 text-center text-sm text-tinta-suave"
  >Cargando dilemas…</div>

  <div id="veredicto" class="mt-3 hidden rounded-xl px-4 py-4 text-center"></div>

  <button
    id="btn-nuevo"
    type="button"
    class="mt-5 w-full rounded-xl boton-principal px-4 py-3.5 font-medium transition active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50"
  >
    <span id="btn-nuevo-texto">Nuevo dilema</span>
  </button>

  <p id="contador-dilemas" class="mt-4 text-center text-xs text-tinta-tenue"></p>

  <section class="mt-6">
    <button
      id="btn-respondidas"
      type="button"
      aria-expanded="false"
      aria-controls="panel-respondidas"
      class="flex w-full items-center justify-between rounded-xl border border-borde px-4 py-3 text-sm font-medium text-tinta-suave transition hover:bg-superficie-alt"
    >
      <span><span aria-hidden="true">📜</span> Ya respondidas</span>
      <span id="respondidas-total" class="text-xs text-tinta-tenue"></span>
    </button>

    <div id="panel-respondidas" hidden class="mt-3 flex flex-col gap-2">
      <p id="respondidas-vacio" class="hidden py-4 text-center text-sm text-tinta-tenue">
        Todavía no han respondido ninguno.
      </p>
      <ul id="lista-respondidas" class="flex flex-col gap-2"></ul>
    </div>
  </section>
</AppLayout>

<script>
  import { protegerPagina } from '../domain/identidad/guardia';
  import { iniciarRelojServidor } from '../domain/tiempo/relojServidor';
  import {
    cargarDilemas, abrirRonda, observarRondaActual, observarMeta, votar,
    observarVotos, archivarPartida, ErrorVoto, elegirSiguienteDilema, cargarPartidas,
    type Dilema, type Opcion, type Votos, type PartidaJugada,
  } from '../domain/dilemas/dilemasService';
  import {
    observarProgreso, marcarHecha, type Progreso,
  } from '../domain/progreso/progresoService';
  import { recientesDe } from '../domain/preguntas/preguntasService';
  import { contarPendientes } from '../domain/banco/seleccion';
  import { otraPersona, type Persona } from '@shared/enums';
  import { ENV } from '../config/env';

  const $ = (id: string) => document.getElementById(id)!;
  const parejaId = ENV.PUBLIC_PAREJA_ID;

  let dilemas: Dilema[] = [];
  let dilemaActual: Dilema | null = null;
  let rondaId: string | null = null;
  let miVoto: Opcion | null = null;
  let cancelarMeta: (() => void) | undefined;
  let cancelarVotos: (() => void) | undefined;
  let progreso: Progreso = { items: {}, hechas: 0, descartadas: 0 };
  let partidas: PartidaJugada[] = [];
  let indice = new Map<string, Dilema>();
  let revelado = false;

  const botones = () => ['A', 'B'].map((o) => $(`opcion-${o}`) as HTMLButtonElement);

  function bloquear(bloqueado: boolean) {
    for (const b of botones()) b.disabled = bloqueado;
  }

  function limpiarMarcas() {
    for (const o of ['A', 'B']) {
      const m = $(`marca-${o}`);
      m.classList.add('hidden');
      m.textContent = '';
      $(`opcion-${o}`).classList.remove('border-acento', 'bg-acento-suave', 'border-salvia', 'bg-salvia-suave');
    }
    $('veredicto').classList.add('hidden');
    revelado = false;
  }

  function pintarDilema(d: Dilema | null) {
    dilemaActual = d;
    $('texto-A').textContent = d?.opcionA ?? '…';
    $('texto-B').textContent = d?.opcionB ?? '…';
  }

  function marcarMiVoto(opcion: Opcion) {
    const b = $(`opcion-${opcion}`);
    b.classList.add('border-acento', 'bg-acento-suave');
    const m = $(`marca-${opcion}`);
    m.textContent = 'Tú';
    m.className = 'absolute top-3 right-3 text-xs font-semibold text-acento';
  }

  /** Revelación: solo se llega aquí cuando el SERVIDOR entregó los dos votos. */
  function revelar(votos: Votos, yo: Persona) {
    revelado = true;
    const mio = votos[yo];
    const suyo = votos[otraPersona(yo)];
    if (!mio || !suyo) return;

    limpiarMarcas();
    revelado = true;

    for (const [persona, voto] of [[yo, mio], [otraPersona(yo), suyo]] as const) {
      const esMio = persona === yo;
      const b = $(`opcion-${voto.opcion}`);
      b.classList.add(esMio ? 'border-acento' : 'border-salvia');
      const m = $(`marca-${voto.opcion}`);
      // Si coincidieron, la misma esquina muestra las dos marcas.
      m.textContent = m.textContent ? `${m.textContent} · ${esMio ? 'Tú' : 'Tu pareja'}` : esMio ? 'Tú' : 'Tu pareja';
      m.className = 'absolute top-3 right-3 text-xs font-semibold text-tinta';
      m.classList.remove('hidden');
    }

    const coinciden = mio.opcion === suyo.opcion;
    const v = $('veredicto');
    v.textContent = coinciden
      ? '¡Coincidieron! Eligieron lo mismo.'
      : 'Cada uno eligió distinto.';
    v.className = coinciden
      ? 'mt-3 rounded-xl border border-salvia/40 bg-salvia-suave px-4 py-4 text-center font-medium text-salvia destello'
      : 'mt-3 rounded-xl border border-borde bg-superficie-alt px-4 py-4 text-center font-medium text-tinta-suave destello';

    $('estado').textContent = 'Ronda revelada.';
    bloquear(true);

    if (dilemaActual) {
      const id = dilemaActual.id;
      void archivarPartida(parejaId, rondaId!, id, {
        [yo]: mio, [otraPersona(yo)]: suyo,
      } as Required<Votos>).then(async () => {
        // Un dilema revelado ES un dilema respondido: se marca hecho para que
        // no vuelva a salir antes que los que faltan, y para que el contador
        // del panel cuadre con la lista de respondidas.
        await marcarHecha(parejaId, 'dilemas', id, yo).catch(() => {});
        partidas = await cargarPartidas(parejaId);
        pintarRespondidas(yo);
      });
    }
  }

  function seguirRonda(id: string, yo: Persona) {
    cancelarMeta?.();
    cancelarVotos?.();
    rondaId = id;
    miVoto = null;
    limpiarMarcas();
    bloquear(false);
    $('estado').textContent = 'Elige una opción. Tu pareja no la verá hasta que vote.';

    cancelarMeta = observarMeta(parejaId, id, (meta) => {
      if (!meta) return;
      const d = dilemas.find((x) => x.id === meta.dilemaId) ?? null;
      if (d && d.id !== dilemaActual?.id) pintarDilema(d);

      if (revelado) return;

      if (meta.votosEmitidos < 2) {
        $('estado').textContent = miVoto
          ? 'Ya votaste. Esperando a tu pareja…'
          : 'Elige una opción. Tu pareja no la verá hasta que vote.';
        return;
      }

      // Los dos votaron: recién ahora el servidor permite leer /votos. Antes de
      // este punto la suscripción devolvería permission_denied.
      cancelarVotos?.();
      cancelarVotos = observarVotos(
        parejaId, id,
        (votos) => { if (votos.a && votos.b) revelar(votos, yo); },
        () => { $('estado').textContent = 'Esperando a que se registren los dos votos…'; },
      );
    });
  }

  function pintarContador() {
    if (dilemas.length === 0) return;
    const c = contarPendientes(dilemas, progreso.items);
    const partes = [`${c.pendientes} sin responder de ${c.total}`];
    if (c.descartadas > 0) partes.push(`${c.descartadas} descartados`);
    $('contador-dilemas').textContent = partes.join(' · ');
  }

  /**
   * Lista de dilemas ya respondidos, con lo que eligió cada uno.
   *
   * Se pinta con createElement y textContent, nunca con innerHTML: el texto
   * viene del banco, que es editable desde el panel, y esa es exactamente la
   * ruta por la que entraría un script si se construyera el HTML como cadena.
   */
  function pintarRespondidas(yo: Persona) {
    const lista = $('lista-respondidas');
    lista.replaceChildren();

    const conTexto = partidas.filter((p) => indice.has(p.dilemaId));
    $('respondidas-total').textContent = conTexto.length ? String(conTexto.length) : '';
    $('respondidas-vacio').classList.toggle('hidden', conTexto.length > 0);

    for (const p of conTexto) {
      const d = indice.get(p.dilemaId)!;
      const mio = yo === 'a' ? p.votoA : p.votoB;
      const suyo = yo === 'a' ? p.votoB : p.votoA;

      const item = document.createElement('li');
      item.className =
        'rounded-xl border border-borde bg-superficie px-4 py-3 ' +
        (p.coincidieron ? 'border-salvia/40 bg-salvia-suave/40' : '');

      const cabecera = document.createElement('p');
      cabecera.className = 'mb-2 text-xs font-medium text-tinta-tenue';
      cabecera.textContent = p.coincidieron ? '💚 Coincidieron' : '↔️ Eligieron distinto';
      item.append(cabecera);

      for (const [letra, texto] of [['A', d.opcionA], ['B', d.opcionB]] as const) {
        const fila = document.createElement('p');
        const elegidaPorMi = mio === letra;
        const elegidaPorElla = suyo === letra;
        fila.className =
          'flex items-start justify-between gap-2 py-0.5 text-sm ' +
          (elegidaPorMi || elegidaPorElla ? 'text-tinta font-medium' : 'text-tinta-tenue');

        const t = document.createElement('span');
        t.textContent = texto;
        fila.append(t);

        const marcas = document.createElement('span');
        marcas.className = 'shrink-0 text-xs';
        marcas.textContent =
          (elegidaPorMi ? 'tú ' : '') + (elegidaPorElla ? 'ella/él' : '');
        fila.append(marcas);

        item.append(fila);
      }

      if (p.cerradaEn > 0) {
        const fecha = document.createElement('p');
        fecha.className = 'mt-1.5 text-[11px] text-tinta-tenue';
        fecha.textContent = new Date(p.cerradaEn).toLocaleDateString('es-CL', {
          day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Santiago',
        });
        item.append(fecha);
      }

      lista.append(item);
    }
  }

  protegerPagina((sesion) => {
    iniciarRelojServidor();
    $('guardia').classList.add('hidden');
    $('app').classList.remove('hidden');
    bloquear(true);

    void (async () => {
      dilemas = await cargarDilemas();
      indice = new Map(dilemas.map((d) => [d.id, d]));
      $('estado').textContent = dilemas.length
        ? 'Pulsa "Nuevo dilema" para empezar.'
        : 'No hay dilemas activos en el banco.';
      ($('btn-nuevo') as HTMLButtonElement).disabled = dilemas.length === 0;
      pintarContador();

      partidas = await cargarPartidas(parejaId);
      pintarRespondidas(sesion.persona);
    })();

    observarProgreso(parejaId, 'dilemas', (p) => {
      progreso = p;
      pintarContador();
    });

    $('btn-respondidas').addEventListener('click', async () => {
      const panel = $('panel-respondidas');
      const abierto = !panel.hidden;
      panel.hidden = abierto;
      $('btn-respondidas').setAttribute('aria-expanded', String(!abierto));

      // Al abrir se recarga: puede haber partidas nuevas jugadas en el otro
      // dispositivo desde que se montó la página.
      if (!abierto) {
        partidas = await cargarPartidas(parejaId);
        pintarRespondidas(sesion.persona);
      }
    });

    observarRondaActual(parejaId, (id) => {
      if (!id || id === rondaId) return;
      seguirRonda(id, sesion.persona);
    });

    for (const b of botones()) {
      b.addEventListener('click', async () => {
        if (!rondaId || miVoto) return;
        const opcion = (b.dataset.opcion ?? 'A') as Opcion;
        bloquear(true);
        try {
          await votar(parejaId, rondaId, sesion.persona, opcion);
          miVoto = opcion;
          marcarMiVoto(opcion);
          $('estado').textContent = 'Ya votaste. Esperando a tu pareja…';
        } catch (e) {
          $('estado').textContent =
            e instanceof ErrorVoto ? e.message : 'No se pudo registrar tu voto.';
          bloquear(false);
        }
      });
    }

    $('btn-nuevo').addEventListener('click', async () => {
      if (dilemas.length === 0) return;
      ($('btn-nuevo') as HTMLButtonElement).disabled = true;
      $('btn-nuevo-texto').textContent = 'Abriendo…';
      try {
        // Mismas reglas que en preguntas: nada de azar puro. Se descartan los
        // pasados tres veces, van primero los que nunca se han respondido y el
        // nivel inclina la moneda.
        const recientes = recientesDe(progreso.items, 25);
        const d = elegirSiguienteDilema(dilemas, progreso.items, recientes, dilemaActual?.id);
        if (!d) {
          $('estado').textContent = 'No quedan dilemas disponibles.';
          return;
        }
        pintarDilema(d);
        await abrirRonda(parejaId, d.id);
      } finally {
        ($('btn-nuevo') as HTMLButtonElement).disabled = false;
        $('btn-nuevo-texto').textContent = 'Otro dilema';
      }
    });
  });
</script>
