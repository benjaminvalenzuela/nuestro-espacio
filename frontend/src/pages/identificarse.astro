---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo="Entrar · Nuestro Espacio" descripcion="Acceso privado">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center gap-8 px-6 py-12">
    <header class="text-center">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-acento-suave" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-8 w-8 fill-acento">
          <path d="M12 21s-7.5-4.7-7.5-9.8A4.3 4.3 0 0 1 12 8.4a4.3 4.3 0 0 1 7.5 2.8C19.5 16.3 12 21 12 21z" />
        </svg>
      </div>
      <h1 class="mt-5 text-2xl font-semibold text-tinta">Nuestro Espacio</h1>
      <p class="mt-2 text-sm text-tinta-suave">Un lugar para los dos.</p>
    </header>

    <div id="cargando" class="tarjeta flex items-center justify-center gap-3 px-6 py-8">
      <span class="h-4 w-4 animate-spin rounded-full border-2 border-borde border-t-acento"></span>
      <span class="text-sm text-tinta-suave">Preparando este dispositivo…</span>
    </div>

    <form id="formulario" class="tarjeta hidden aparecer flex flex-col gap-5 px-6 py-7" novalidate>
      <div>
        <label for="nombre" class="mb-1.5 block text-sm font-medium text-tinta">
          ¿Cómo te llamas?
        </label>
        <input
          id="nombre"
          name="nombre"
          type="text"
          autocomplete="given-name"
          enterkeyhint="next"
          maxlength="40"
          placeholder="Tu nombre"
          class="w-full rounded-xl border border-borde bg-superficie-alt px-4 py-3 text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none"
        />
      </div>

      <div>
        <label for="codigo" class="mb-1.5 block text-sm font-medium text-tinta">
          Código de acceso
        </label>
        <input
          id="codigo"
          name="codigo"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          enterkeyhint="go"
          placeholder="A-K3F9-2XQ7-M8T4"
          class="w-full rounded-xl border border-borde bg-superficie-alt px-4 py-3 font-mono tracking-wider text-tinta uppercase placeholder:font-sans placeholder:tracking-normal placeholder:text-tinta-tenue placeholder:normal-case focus:border-acento focus:outline-none"
        />
        <p class="mt-1.5 text-xs text-tinta-tenue">
          Solo la primera vez en cada dispositivo. Después entras directo.
        </p>
      </div>

      <button
        id="btn-entrar"
        type="submit"
        class="rounded-xl bg-acento px-4 py-3.5 font-medium text-white transition hover:bg-acento-fuerte active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span id="btn-texto">Entrar</span>
      </button>

      <p
        id="error"
        role="alert"
        class="hidden rounded-xl border border-peligro/30 bg-peligro/5 px-4 py-3 text-sm text-peligro"
      >
      </p>
    </form>

    <p class="text-center text-xs leading-relaxed text-tinta-tenue">
      Este espacio es privado.<br />Sin el código no se puede entrar.
    </p>
  </main>
</BaseLayout>

<script>
  import {
    $identidad,
    iniciarIdentidad,
    vincularDispositivo,
    ErrorVinculacion,
  } from '../domain/identidad/identidad';
  import { normalizarCodigo, formatearCodigo } from '@shared/schemas/codigo';
  import { ruta } from '../config/env';

  const $ = (id: string) => document.getElementById(id)!;

  const cargando = $('cargando');
  const formulario = $('formulario') as HTMLFormElement;
  const inputNombre = $('nombre') as HTMLInputElement;
  const inputCodigo = $('codigo') as HTMLInputElement;
  const btn = $('btn-entrar') as HTMLButtonElement;
  const btnTexto = $('btn-texto');
  const error = $('error');

  function mostrarError(mensaje: string | null) {
    // textContent, nunca innerHTML: tercera capa anti-XSS.
    error.textContent = mensaje ?? '';
    error.classList.toggle('hidden', !mensaje);
  }

  // Formatea el código mientras se escribe (A-XXXX-XXXX-XXXX) para que se vea
  // igual que en el papel. Se respeta el pegado desde el portapapeles.
  inputCodigo.addEventListener('input', () => {
    const limpio = normalizarCodigo(inputCodigo.value).slice(0, 13);
    if (!limpio) {
      inputCodigo.value = '';
      return;
    }
    const letra = limpio[0] === 'B' ? 'b' : 'a';
    inputCodigo.value =
      limpio.length === 1 ? limpio : formatearCodigo(letra, limpio.slice(1));
  });

  iniciarIdentidad();

  $identidad.subscribe((s) => {
    cargando.classList.toggle('hidden', s.fase !== 'cargando');
    formulario.classList.toggle('hidden', s.fase !== 'sin-vincular');

    // Este dispositivo ya está vinculado: adentro. replace() para que "atrás"
    // no devuelva a esta pantalla.
    if (s.fase === 'vinculado') window.location.replace(ruta('/inicio'));
  });

  formulario.addEventListener('submit', async (e) => {
    e.preventDefault();
    mostrarError(null);
    btn.disabled = true;
    btnTexto.textContent = 'Comprobando…';

    try {
      await vincularDispositivo(inputNombre.value, inputCodigo.value);
      // La suscripción de arriba redirige al pasar a 'vinculado'.
    } catch (err) {
      mostrarError(
        err instanceof ErrorVinculacion
          ? err.message
          : 'No se pudo completar. Revisa tu conexión e inténtalo otra vez.',
      );
      btn.disabled = false;
      btnTexto.textContent = 'Entrar';
    }
  });
</script>
