---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout
  titulo="Preguntas · Nuestro Espacio"
  encabezado="Preguntas"
  bajada="La misma carta en las dos pantallas, sin repetir lo reciente."
  ancho="lectura"
>
  <div
    id="filtros"
    role="group"
    aria-label="Categoría de preguntas"
    class="mb-5 flex flex-wrap gap-2"
  >
    {
      [
        ['mix', '🎲 Mix'],
        ['profundas', '💭 Profundas'],
        ['subidas_de_tono', '🔥 Subidas de tono'],
        ['supuestos', '🤔 Supuestos'],
      ].map(([valor, etiqueta]) => (
        <button
          type="button"
          data-filtro={valor}
          class="rounded-full border border-borde px-3.5 py-2 text-sm font-medium text-tinta-suave transition"
        >{etiqueta}</button>
      ))
    }
  </div>

  <section class="tarjeta relative flex min-h-56 flex-col justify-between gap-5 px-5 py-7">
    <div class="flex items-start justify-between gap-3">
      <p id="etiqueta-categoria" class="text-[11px] font-medium tracking-wide text-acento uppercase"></p>
      <p id="etiqueta-nivel" class="hidden text-[11px] font-medium tracking-wide text-tinta-tenue uppercase"></p>
    </div>

    <p id="texto-pregunta" class="text-center text-xl leading-relaxed font-medium text-balance text-tinta">
      Elige una categoría y pulsa para empezar.
    </p>

    <div class="flex flex-col gap-1.5">
      <p
        id="sello-hecha"
        class="hidden rounded-lg bg-salvia-suave px-3 py-2 text-center text-xs font-medium text-salvia"
      ></p>
      <p id="pie-pregunta" class="text-center text-xs text-tinta-tenue"></p>
    </div>
  </section>

  <div id="acciones" class="mt-4 grid grid-cols-2 gap-2.5">
    <button
      id="btn-pasar"
      type="button"
      class="rounded-xl border border-borde px-4 py-3 font-medium text-tinta-suave transition hover:bg-superficie-alt active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40"
    >
      <span aria-hidden="true">⏭️</span> <span id="btn-pasar-texto">Pasar</span>
    </button>
    <button
      id="btn-hecha"
      type="button"
      class="rounded-xl border border-salvia/40 bg-salvia-suave px-4 py-3 font-medium text-salvia transition hover:bg-salvia/15 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40"
    >
      <span aria-hidden="true">✅</span> <span id="btn-hecha-texto">Hecha</span>
    </button>
  </div>

  <button
    id="btn-siguiente"
    type="button"
    class="mt-2.5 w-full rounded-xl boton-principal px-4 py-3.5 font-medium transition active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50"
  >
    <span id="btn-siguiente-texto">Empezar</span>
  </button>

  <p id="estado-banco" class="mt-4 text-center text-xs text-tinta-tenue"></p>
  <p id="aviso" role="status" class="mt-2 text-center text-xs text-acento"></p>
</AppLayout>

<script>
  import { protegerPagina } from '../domain/identidad/guardia';
  import { iniciarRelojServidor } from '../domain/tiempo/relojServidor';
  import {
    cargarPreguntas, observarPreguntaActiva, leerVentana, recientesDe,
    elegirSiguiente, contarPendientes, servirPregunta, registrarServida,
    type Pregunta, type FiltroCategoria,
  } from '../domain/preguntas/preguntasService';
  import {
    observarProgreso, marcarHecha, desmarcarHecha, pasar, selloDe,
    PASES_PARA_DESCARTAR, type Progreso,
  } from '../domain/progreso/progresoService';
  import { ETIQUETA_CATEGORIA, ETIQUETA_NIVEL } from '@shared/enums';
  import { ENV } from '../config/env';

  const $ = (id: string) => document.getElementById(id)!;
  const parejaId = ENV.PUBLIC_PAREJA_ID;

  let filtro: FiltroCategoria = 'mix';
  let catalogo: Pregunta[] = [];
  /** Índice global id -> pregunta: la carta activa puede ser de otra categoría
   *  que la seleccionada aquí, si fue la otra persona quien la sirvió. */
  const indice = new Map<string, Pregunta>();
  let progreso: Progreso = { items: {}, hechas: 0, descartadas: 0 };
  let ventana = 25;
  let idActual: string | null = null;
  let ocupado = false;
  let cancelarActiva: (() => void) | undefined;

  const btn = (id: string) => $(id) as HTMLButtonElement;

  function avisar(texto: string) {
    $('aviso').textContent = texto;
    if (texto) setTimeout(() => { $('aviso').textContent = ''; }, 3500);
  }

  function marcarFiltro() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('#filtros button')) {
      const activo = b.dataset.filtro === filtro;
      b.classList.toggle('border-acento', activo);
      b.classList.toggle('bg-acento-suave', activo);
      b.classList.toggle('text-acento', activo);
      b.classList.toggle('text-tinta-suave', !activo);
      b.setAttribute('aria-pressed', String(activo));
    }
  }

  /**
   * Pinta el sello de "ya la hicimos".
   *
   * Las hechas no se retiran de la rotación: vuelven a salir, y cuando lo hacen
   * se avisa con la fecha. Es lo que se pidió, y con dos mil cartas es lo
   * correcto — si desaparecieran, no habría forma de reencontrar una
   * conversación que valió la pena.
   */
  function pintarEstado() {
    const e = idActual ? progreso.items[idActual] : undefined;
    const sello = selloDe(e);

    $('sello-hecha').classList.toggle('hidden', !sello);
    if (sello) $('sello-hecha').textContent = `✅ Ya la hicieron · ${sello}`;

    $('btn-hecha-texto').textContent = e?.h ? 'Deshacer' : 'Hecha';
    btn('btn-hecha').setAttribute('aria-pressed', String(Boolean(e?.h)));

    const pases = e?.p ?? 0;
    $('btn-pasar-texto').textContent =
      pases > 0 ? `Pasar (${pases}/${PASES_PARA_DESCARTAR})` : 'Pasar';

    const hayCarta = Boolean(idActual);
    btn('btn-hecha').disabled = !hayCarta;
    btn('btn-pasar').disabled = !hayCarta;
  }

  function limpiarCarta() {
    idActual = null;
    $('texto-pregunta').textContent = 'Pulsa para sacar una pregunta de esta categoría.';
    $('etiqueta-categoria').textContent = '';
    $('etiqueta-nivel').classList.add('hidden');
    $('pie-pregunta').textContent = '';
    $('btn-siguiente-texto').textContent = 'Sacar pregunta';
    pintarEstado();
  }

  function mostrarPregunta(p: Pregunta | null, servidaPorMi: boolean) {
    // textContent siempre: el banco lo edita el panel, pero el principio no cambia.
    $('texto-pregunta').textContent = p ? p.texto : 'No hay preguntas en esta categoría.';
    $('etiqueta-categoria').textContent = p ? (ETIQUETA_CATEGORIA[p.categoria] ?? '') : '';

    // El nivel solo se anuncia donde significa algo.
    const muestraNivel = Boolean(p && p.categoria === 'subidas_de_tono');
    $('etiqueta-nivel').classList.toggle('hidden', !muestraNivel);
    if (muestraNivel && p) $('etiqueta-nivel').textContent = ETIQUETA_NIVEL[p.nivel] ?? '';

    $('pie-pregunta').textContent = p
      ? servidaPorMi ? 'La sacaste tú' : 'La sacó tu pareja'
      : '';

    $('texto-pregunta').classList.remove('destello');
    void $('texto-pregunta').offsetWidth;   // reinicia la animación
    if (p) $('texto-pregunta').classList.add('destello');

    pintarEstado();
  }

  function pintarContador() {
    if (catalogo.length === 0) {
      $('estado-banco').textContent = 'No hay preguntas activas en esta categoría.';
      return;
    }
    const c = contarPendientes(catalogo, progreso.items);
    const partes = [`${c.pendientes} sin estrenar de ${c.total}`];
    if (c.hechas > 0) partes.push(`${c.hechas} hechas`);
    if (c.descartadas > 0) partes.push(`${c.descartadas} descartadas`);
    $('estado-banco').textContent = partes.join(' · ');
  }

  async function recargarCatalogo() {
    catalogo = await cargarPreguntas(filtro);
    for (const p of catalogo) indice.set(p.id, p);
    pintarContador();
    btn('btn-siguiente').disabled = catalogo.length === 0;
  }

  function escucharCategoria(yo: string) {
    const deEsteFiltro = filtro;
    return observarPreguntaActiva(parejaId, deEsteFiltro, (activa) => {
      if (deEsteFiltro !== filtro) return;   // llegó tarde tras cambiar de filtro
      if (!activa) { limpiarCarta(); return; }
      if (activa.preguntaId === idActual) return;
      idActual = activa.preguntaId;
      mostrarPregunta(indice.get(activa.preguntaId) ?? null, activa.servidaPor === yo);
      $('btn-siguiente-texto').textContent = 'Siguiente pregunta';
    });
  }

  protegerPagina((sesion) => {
    iniciarRelojServidor();
    $('guardia').classList.add('hidden');
    $('app').classList.remove('hidden');
    marcarFiltro();
    pintarEstado();

    void (async () => {
      ventana = await leerVentana(parejaId);
      // El índice completo permite mostrar cualquier carta que llegue por RTDB,
      // aunque este dispositivo tenga otro filtro seleccionado.
      for (const p of await cargarPreguntas('mix')) indice.set(p.id, p);
      await recargarCatalogo();
    })();

    // El progreso es compartido: lo que uno marca aparece en la otra pantalla.
    observarProgreso(parejaId, 'preguntas', (p) => {
      progreso = p;
      pintarEstado();
      pintarContador();
    });

    cancelarActiva = escucharCategoria(sesion.persona);

    for (const b of document.querySelectorAll<HTMLButtonElement>('#filtros button')) {
      b.addEventListener('click', async () => {
        const nuevo = (b.dataset.filtro ?? 'mix') as FiltroCategoria;
        if (nuevo === filtro) return;
        filtro = nuevo;
        marcarFiltro();

        // Cada categoría tiene SU propia carta en curso. Se limpia la tarjeta y
        // se escucha el nodo del filtro nuevo: así no se arrastra la pregunta
        // de "Mix" a "Profundas".
        limpiarCarta();
        cancelarActiva?.();
        cancelarActiva = escucharCategoria(sesion.persona);

        await recargarCatalogo();
      });
    }

    async function sacarSiguiente() {
      if (ocupado || catalogo.length === 0) return;
      ocupado = true;
      btn('btn-siguiente').disabled = true;

      try {
        const recientes = recientesDe(progreso.items, ventana);
        const elegida = elegirSiguiente(catalogo, progreso.items, recientes, idActual);
        if (!elegida) {
          avisar('No quedan preguntas disponibles en esta categoría.');
          return;
        }
        // Solo anota quien realmente sirvió: si los dos pulsaron a la vez, el
        // antirrebote del servidor deja pasar a uno y el otro no duplica nada.
        const servi = await servirPregunta(parejaId, sesion.persona, elegida, filtro);
        if (servi) await registrarServida(parejaId, elegida.id);
      } finally {
        ocupado = false;
        btn('btn-siguiente').disabled = catalogo.length === 0;
      }
    }

    $('btn-siguiente').addEventListener('click', sacarSiguiente);

    $('btn-hecha').addEventListener('click', async () => {
      if (!idActual) return;
      const yaEstaba = progreso.items[idActual]?.h;
      const id = idActual;

      btn('btn-hecha').disabled = true;
      try {
        if (yaEstaba) {
          await desmarcarHecha(parejaId, 'preguntas', id);
          avisar('Ya no está marcada como hecha.');
        } else {
          await marcarHecha(parejaId, 'preguntas', id, sesion.persona);
          avisar('Marcada como hecha. Si vuelve a salir, lo verán.');
          await sacarSiguiente();
        }
      } catch {
        avisar('No se pudo guardar. Revisa la conexión.');
      } finally {
        btn('btn-hecha').disabled = false;
      }
    });

    $('btn-pasar').addEventListener('click', async () => {
      if (!idActual) return;
      const id = idActual;

      btn('btn-pasar').disabled = true;
      try {
        const r = await pasar(parejaId, 'preguntas', id, progreso);
        avisar(
          r.descartada
            ? 'Pasada tres veces: no volverá a salir.'
            : `Pasada ${r.pases} de ${PASES_PARA_DESCARTAR}.`,
        );
        await sacarSiguiente();
      } catch {
        avisar('No se pudo guardar. Revisa la conexión.');
      } finally {
        btn('btn-pasar').disabled = false;
      }
    });
  });
</script>
