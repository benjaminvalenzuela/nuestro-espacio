---
import AppLayout from '../layouts/AppLayout.astro';

const CATS_PREGUNTA = [
  ['profundas', '💭 Profundas'],
  ['subidas_de_tono', '🔥 Subidas de tono'],
  ['supuestos', '🤔 Supuestos'],
];
const CATS_DILEMA = [
  ['general', '🎯 General'],
  ['profundas', '💭 Profundas'],
  ['subidas_de_tono', '🔥 Subidas de tono'],
  ['absurdas', '🤪 Absurdas'],
];
---

<AppLayout
  titulo="Administración · Nuestro Espacio"
  encabezado="Administración"
  bajada="Gestiona el contenido y los historiales sin tocar el código."
>
  <div id="secciones" role="tablist" class="mb-5 grid grid-cols-5 gap-1.5">
    {
      [
        ['banco', '🗂️'],
        ['nuevo', '➕'],
        ['progreso', '📊'],
        ['datos', '🧹'],
        ['registro', '📋'],
      ].map(([v, t]) => (
        <button type="button" role="tab" data-sec={v}
          class="rounded-lg border border-borde px-2 py-2.5 text-base transition"
        >{t}</button>
      ))
    }
  </div>

  {/* ── BANCO ─────────────────────────────────────────────────────────── */}
  <section id="sec-banco" role="tabpanel" class="hidden flex-col gap-3">
    <div class="flex gap-2">
      <button type="button" data-juego="preguntas"
        class="juego-tab flex-1 rounded-lg border border-borde px-3 py-2 text-sm font-medium transition">
        Preguntas
      </button>
      <button type="button" data-juego="dilemas"
        class="juego-tab flex-1 rounded-lg border border-borde px-3 py-2 text-sm font-medium transition">
        Qué prefieres
      </button>
    </div>

    <input id="buscador" type="search" placeholder="🔍 Buscar en el banco…"
      class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none" />

    <select id="filtro-categoria"
      class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none">
      <option value="todas">Todas las categorías</option>
    </select>

    <p id="banco-resumen" class="text-xs text-tinta-tenue"></p>
    <ul id="lista-banco" class="flex flex-col gap-2"></ul>
    <button id="ver-mas" type="button" hidden
      class="rounded-lg border border-borde px-3 py-2.5 text-sm font-medium text-tinta-suave transition hover:bg-superficie-alta">
      Ver más
    </button>
  </section>

  {/* ── NUEVO ─────────────────────────────────────────────────────────── */}
  <section id="sec-nuevo" role="tabpanel" class="hidden flex-col gap-4">
    <div class="tarjeta flex flex-col gap-3 px-4 py-4">
      <p class="text-sm font-semibold text-tinta">➕ Nueva pregunta</p>
      <textarea id="np-texto" rows="3" maxlength="300" placeholder="¿Qué es lo que más miedo te da…?"
        class="w-full resize-none rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none"></textarea>
      <select id="np-categoria"
        class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none">
        {CATS_PREGUNTA.map(([v, t]) => <option value={v}>{t}</option>)}
      </select>
      <div id="np-nivel-caja" class="hidden flex-col gap-1.5">
        <label for="np-nivel" class="text-xs text-tinta-tenue">Intensidad</label>
        <select id="np-nivel"
          class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none">
          <option value="1">1 · Suave</option>
          <option value="2">2 · Directa</option>
          <option value="3">3 · Explícita</option>
        </select>
      </div>
      <button id="np-crear" type="button"
        class="rounded-lg bg-acento px-3 py-2.5 text-sm font-medium text-white transition hover:bg-acento-fuerte">
        Agregar pregunta
      </button>
    </div>

    <div class="tarjeta flex flex-col gap-3 px-4 py-4">
      <p class="text-sm font-semibold text-tinta">➕ Nuevo «qué prefieres»</p>
      <input id="nd-a" type="text" maxlength="120" placeholder="Opción A"
        class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none" />
      <input id="nd-b" type="text" maxlength="120" placeholder="Opción B"
        class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none" />
      <select id="nd-categoria"
        class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none">
        {CATS_DILEMA.map(([v, t]) => <option value={v}>{t}</option>)}
      </select>
      <div id="nd-nivel-caja" class="hidden flex-col gap-1.5">
        <label for="nd-nivel" class="text-xs text-tinta-tenue">Intensidad</label>
        <select id="nd-nivel"
          class="w-full rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none">
          <option value="1">1 · Suave</option>
          <option value="2">2 · Directa</option>
          <option value="3">3 · Explícita</option>
        </select>
      </div>
      <button id="nd-crear" type="button"
        class="rounded-lg bg-acento px-3 py-2.5 text-sm font-medium text-white transition hover:bg-acento-fuerte">
        Agregar dilema
      </button>
    </div>
  </section>

  {/* ── PROGRESO ──────────────────────────────────────────────────────── */}
  <section id="sec-progreso" role="tabpanel" class="hidden flex-col gap-4">
    <div class="grid grid-cols-2 gap-2.5">
      <button id="tarjeta-preguntas" type="button"
        class="tarjeta flex flex-col items-start gap-1 px-4 py-4 text-left transition hover:border-acento">
        <span class="text-xs text-tinta-tenue">Preguntas hechas</span>
        <span id="m-preguntas" class="text-2xl font-semibold text-tinta">—</span>
        <span id="m-preguntas-pie" class="text-[11px] text-tinta-tenue"></span>
      </button>
      <button id="tarjeta-dilemas" type="button"
        class="tarjeta flex flex-col items-start gap-1 px-4 py-4 text-left transition hover:border-acento">
        <span class="text-xs text-tinta-tenue">Dilemas respondidos</span>
        <span id="m-dilemas" class="text-2xl font-semibold text-tinta">—</span>
        <span id="m-dilemas-pie" class="text-[11px] text-tinta-tenue"></span>
      </button>
    </div>

    <div id="detalle" hidden class="flex flex-col gap-3">
      <div class="flex items-center justify-between gap-2">
        <p id="detalle-titulo" class="text-sm font-semibold text-tinta"></p>
        <button id="detalle-cerrar" type="button"
          class="rounded-lg border border-borde px-2.5 py-1.5 text-xs text-tinta-suave transition hover:bg-superficie-alta">
          Cerrar
        </button>
      </div>

      <div class="flex flex-wrap gap-2">
        <button id="sel-todas" type="button"
          class="rounded-lg border border-borde px-3 py-2 text-xs font-medium text-tinta-suave transition hover:bg-superficie-alta">
          Seleccionar todas
        </button>
        <button id="sel-ninguna" type="button"
          class="rounded-lg border border-borde px-3 py-2 text-xs font-medium text-tinta-suave transition hover:bg-superficie-alta">
          Ninguna
        </button>
        <button id="sel-eliminar" type="button" disabled
          class="ml-auto rounded-lg border border-peligro/40 px-3 py-2 text-xs font-medium text-peligro transition hover:bg-peligro/5 disabled:opacity-40">
          Eliminar seleccionadas
        </button>
      </div>

      <p id="detalle-resumen" class="text-xs text-tinta-tenue"></p>
      <ul id="lista-detalle" class="flex flex-col gap-2"></ul>
    </div>
  </section>

  {/* ── DATOS ─────────────────────────────────────────────────────────── */}
  <section id="sec-datos" role="tabpanel" class="hidden flex-col gap-4">
    <div class="tarjeta flex flex-col gap-3 px-4 py-4">
      <p class="text-sm font-semibold text-tinta">Anti-repetición</p>
      <p class="text-xs text-tinta-tenue">
        Cuántas cartas recientes se descartan antes de volver a sacarlas.
        Se recorta sola si el catálogo es pequeño.
      </p>
      <div class="flex gap-2">
        <input id="cfg-ventana" type="number" min="0" max="500"
          class="min-w-0 flex-1 rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none" />
        <button id="cfg-guardar" type="button"
          class="shrink-0 rounded-lg border border-acento px-3 py-2.5 text-sm font-medium text-acento transition hover:bg-acento-suave">
          Guardar
        </button>
      </div>
    </div>

    <div class="tarjeta flex flex-col gap-3 px-4 py-4">
      <p class="text-sm font-semibold text-peligro">Zona de limpieza</p>
      <p class="text-xs text-tinta-tenue">
        Estas acciones borran datos de forma definitiva y quedan registradas en
        el registro de actividad. El banco de preguntas y dilemas nunca se toca
        desde aquí.
      </p>
      <div id="limpiezas" class="flex flex-col gap-2"></div>
      <button id="reiniciar-marcador" type="button"
        class="rounded-lg border border-peligro/40 px-3 py-2.5 text-sm font-medium text-peligro transition hover:bg-peligro/5">
        Reiniciar marcador de organización
      </button>
    </div>
  </section>

  {/* ── REGISTRO ──────────────────────────────────────────────────────── */}
  <section id="sec-registro" role="tabpanel" class="hidden flex-col gap-3">
    <p class="text-xs text-tinta-tenue">
      Append-only e inmutable: nadie, ni el administrador, puede editar o borrar
      estas entradas.
    </p>
    <ul id="lista-auditoria" class="flex flex-col gap-2"></ul>
  </section>

  <p id="admin-error" role="alert" class="mt-4 hidden rounded-xl border border-peligro/30 bg-peligro/5 px-4 py-2.5 text-sm text-peligro"></p>
  <p id="admin-ok" role="status" class="mt-4 hidden rounded-xl border border-salvia/30 bg-salvia-suave px-4 py-2.5 text-sm text-salvia"></p>
</AppLayout>

<script>
  import { protegerPagina } from '../domain/identidad/guardia';
  import {
    observarConfig, guardarVentana, contar, limpiarColeccion, reiniciarMarcador,
    observarAuditoria, ETIQUETA_COLECCION, ErrorAdmin,
    type Coleccion, type EventoAuditoria,
  } from '../domain/admin/adminService';
  import {
    cargarFilas, filtrar, calcularMetricas, crearPregunta, crearDilema,
    retirarDelBanco, type FilaBanco,
  } from '../domain/admin/bancoAdmin';
  import { leerProgreso, type Juego } from '../domain/progreso/progresoService';
  import { formatearUltimaConexion } from '../domain/presencia/formatoFecha';
  import { observarNombre } from '../domain/presencia/presenciaService';
  import {
    ETIQUETA_CATEGORIA, ETIQUETA_NIVEL,
    type CategoriaPregunta, type CategoriaDilema, type Nivel, type Persona,
  } from '@shared/enums';
  import { ENV } from '../config/env';

  const $ = (id: string) => document.getElementById(id)!;
  const parejaId = ENV.PUBLIC_PAREJA_ID;
  const COLECCIONES: Coleccion[] = ['historialPanoramas', 'historialOrganizacion', 'partidasDilemas'];

  /** Cuántas filas se pintan de golpe. Con dos mil cartas, volcarlas todas al
   *  DOM congela el teléfono varios segundos; se pagina y se filtra. */
  const PAGINA = 40;

  let yo: Persona = 'a';
  const nombres: Record<Persona, string> = { a: 'Persona A', b: 'Persona B' };

  let juego: Juego = 'preguntas';
  let filas: FilaBanco[] = [];
  let mostradas = PAGINA;

  let detalleJuego: Juego = 'preguntas';
  let detalleFilas: FilaBanco[] = [];
  const seleccion = new Set<string>();

  function aviso(texto: string | null, tipo: 'error' | 'ok' = 'error') {
    const el = $(tipo === 'error' ? 'admin-error' : 'admin-ok');
    const otro = $(tipo === 'error' ? 'admin-ok' : 'admin-error');
    otro.classList.add('hidden');
    el.textContent = texto ?? '';
    el.classList.toggle('hidden', !texto);
    if (texto && tipo === 'ok') setTimeout(() => el.classList.add('hidden'), 3500);
  }

  function verSeccion(cual: string) {
    for (const s of ['banco', 'nuevo', 'progreso', 'datos', 'registro']) {
      const el = $(`sec-${s}`);
      el.classList.toggle('hidden', s !== cual);
      el.classList.toggle('flex', s === cual);
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>('#secciones button')) {
      const on = b.dataset.sec === cual;
      b.classList.toggle('border-acento', on);
      b.classList.toggle('bg-acento-suave', on);
      b.setAttribute('aria-selected', String(on));
    }
  }

  // ── Banco ─────────────────────────────────────────────────────────────

  function opcionesCategoria() {
    const sel = $('filtro-categoria') as HTMLSelectElement;
    const cats =
      juego === 'preguntas'
        ? ['profundas', 'subidas_de_tono', 'supuestos']
        : ['general', 'profundas', 'subidas_de_tono', 'absurdas'];
    sel.replaceChildren();
    const todas = document.createElement('option');
    todas.value = 'todas';
    todas.textContent = 'Todas las categorías';
    sel.append(todas);
    for (const c of cats) {
      const o = document.createElement('option');
      o.value = c;
      o.textContent = ETIQUETA_CATEGORIA[c as CategoriaPregunta] ?? c;
      sel.append(o);
    }
  }

  function marcarJuego() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('.juego-tab')) {
      const on = b.dataset.juego === juego;
      b.classList.toggle('border-acento', on);
      b.classList.toggle('bg-acento-suave', on);
      b.classList.toggle('text-acento', on);
      b.classList.toggle('text-tinta-suave', !on);
    }
  }

  /** Fila del banco. Todo con createElement: el texto es editable y nunca se
   *  interpola en HTML. */
  function filaBanco(f: FilaBanco, activa: boolean): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'tarjeta flex items-start gap-3 px-4 py-3';

    const col = document.createElement('div');
    col.className = 'min-w-0 flex-1';

    const t = document.createElement('p');
    t.className = 'text-sm text-tinta';
    t.textContent = f.titulo;
    col.append(t);

    const meta = document.createElement('p');
    meta.className = 'mt-1 flex flex-wrap gap-x-2 text-[11px] text-tinta-tenue';
    const trozos = [ETIQUETA_CATEGORIA[f.categoria as CategoriaPregunta] ?? f.categoria];
    if (f.categoria === 'subidas_de_tono') trozos.push(ETIQUETA_NIVEL[f.nivel] ?? '');
    if (f.hecha) trozos.push('✅ hecha');
    if (f.descartada) trozos.push('🚫 descartada');
    else if (f.pases > 0) trozos.push(`⏭️ ${f.pases} pases`);
    meta.textContent = trozos.filter(Boolean).join(' · ');
    col.append(meta);

    li.append(col);

    const quitar = document.createElement('button');
    quitar.type = 'button';
    quitar.className =
      'shrink-0 rounded-full border border-borde px-2.5 py-1 text-[11px] font-semibold text-tinta-tenue transition hover:border-peligro hover:text-peligro';
    quitar.textContent = 'Eliminar';
    quitar.addEventListener('click', async () => {
      if (quitar.dataset.armado !== 'si') {
        quitar.dataset.armado = 'si';
        quitar.textContent = '¿Seguro?';
        setTimeout(() => { quitar.dataset.armado = ''; quitar.textContent = 'Eliminar'; }, 4000);
        return;
      }
      quitar.disabled = true;
      try {
        await retirarDelBanco(parejaId, yo, juego, [f.id]);
        aviso('Eliminada del banco. No volverá a salir.', 'ok');
        await recargarBanco();
      } catch {
        aviso('No se pudo eliminar.');
        quitar.disabled = false;
      }
    });

    if (activa) li.append(quitar);
    return li;
  }

  function pintarBanco() {
    const texto = ($('buscador') as HTMLInputElement).value;
    const cat = ($('filtro-categoria') as HTMLSelectElement).value;
    const visibles = filtrar(filas, texto, cat);

    const ul = $('lista-banco');
    ul.replaceChildren();
    for (const f of visibles.slice(0, mostradas)) ul.append(filaBanco(f, true));

    $('banco-resumen').textContent =
      visibles.length === filas.length
        ? `${filas.length} en el banco`
        : `${visibles.length} de ${filas.length}`;

    const masCount = visibles.length - mostradas;
    ($('ver-mas') as HTMLButtonElement).hidden = masCount <= 0;
    $('ver-mas').textContent = `Ver ${Math.min(masCount, PAGINA)} más`;
  }

  async function recargarBanco() {
    const progreso = await leerProgreso(parejaId, juego);
    filas = await cargarFilas(juego, progreso.items);
    mostradas = PAGINA;
    pintarBanco();
    await pintarMetricas();
  }

  // ── Progreso ──────────────────────────────────────────────────────────

  async function pintarMetricas() {
    for (const j of ['preguntas', 'dilemas'] as Juego[]) {
      const progreso = await leerProgreso(parejaId, j);
      const m = calcularMetricas(await cargarFilas(j, progreso.items));
      $(`m-${j}`).textContent = String(m.hechas);
      $(`m-${j}-pie`).textContent =
        `${m.porcentaje}% de ${m.total}` + (m.descartadas ? ` · ${m.descartadas} descartadas` : '');
    }
  }

  function pintarDetalle() {
    const ul = $('lista-detalle');
    ul.replaceChildren();

    if (detalleFilas.length === 0) {
      const vacio = document.createElement('li');
      vacio.className =
        'rounded-xl border border-dashed border-borde px-4 py-8 text-center text-sm text-tinta-tenue';
      vacio.textContent = 'Todavía no han marcado ninguna como hecha.';
      ul.append(vacio);
    }

    for (const f of detalleFilas.slice(0, 200)) {
      const li = document.createElement('li');
      li.className = 'tarjeta flex items-start gap-3 px-4 py-3';

      const check = document.createElement('input');
      check.type = 'checkbox';
      check.className = 'mt-1 size-4 shrink-0 accent-current';
      check.checked = seleccion.has(f.id);
      check.addEventListener('change', () => {
        if (check.checked) seleccion.add(f.id); else seleccion.delete(f.id);
        actualizarSeleccion();
      });

      const col = document.createElement('div');
      col.className = 'min-w-0 flex-1';
      const t = document.createElement('p');
      t.className = 'text-sm text-tinta';
      t.textContent = f.titulo;
      const meta = document.createElement('p');
      meta.className = 'mt-1 text-[11px] text-tinta-tenue';
      meta.textContent = ETIQUETA_CATEGORIA[f.categoria as CategoriaPregunta] ?? f.categoria;
      col.append(t, meta);

      li.append(check, col);
      ul.append(li);
    }

    if (detalleFilas.length > 200) {
      const nota = document.createElement('li');
      nota.className = 'px-1 text-xs text-tinta-tenue';
      nota.textContent = `Mostrando 200 de ${detalleFilas.length}. Usa "Seleccionar todas" para actuar sobre el resto.`;
      ul.append(nota);
    }

    actualizarSeleccion();
  }

  function actualizarSeleccion() {
    const n = seleccion.size;
    ($('sel-eliminar') as HTMLButtonElement).disabled = n === 0;
    $('sel-eliminar').textContent = n === 0 ? 'Eliminar seleccionadas' : `Eliminar ${n}`;
    $('detalle-resumen').textContent =
      `${detalleFilas.length} hechas · ${n} seleccionada${n === 1 ? '' : 's'}`;
  }

  async function abrirDetalle(j: Juego) {
    detalleJuego = j;
    seleccion.clear();
    const progreso = await leerProgreso(parejaId, j);
    detalleFilas = (await cargarFilas(j, progreso.items)).filter((f) => f.hecha && !f.descartada);
    $('detalle-titulo').textContent =
      j === 'preguntas' ? 'Preguntas ya hechas' : 'Dilemas ya respondidos';
    $('detalle').hidden = false;
    pintarDetalle();
    $('detalle').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Limpieza y registro ───────────────────────────────────────────────

  async function pintarLimpiezas() {
    const cont = $('limpiezas');
    cont.replaceChildren();
    for (const c of COLECCIONES) {
      const n = await contar(parejaId, c).catch(() => 0);
      const b = document.createElement('button');
      b.type = 'button';
      b.disabled = n === 0;
      b.className =
        'flex items-center justify-between rounded-lg border border-borde px-3 py-2.5 text-sm transition disabled:opacity-40 ' +
        (n > 0 ? 'text-tinta hover:border-peligro hover:text-peligro' : 'text-tinta-tenue');
      const t = document.createElement('span');
      t.textContent = ETIQUETA_COLECCION[c];
      const cuenta = document.createElement('span');
      cuenta.className = 'text-xs font-semibold';
      cuenta.textContent = n === 0 ? 'vacío' : `${n} · limpiar`;
      b.append(t, cuenta);

      b.addEventListener('click', async () => {
        // Doble confirmación: la primera pulsación arma, la segunda ejecuta.
        if (b.dataset.armado !== 'si') {
          b.dataset.armado = 'si';
          cuenta.textContent = '¿Seguro? Pulsa otra vez';
          setTimeout(() => { b.dataset.armado = ''; cuenta.textContent = `${n} · limpiar`; }, 4000);
          return;
        }
        b.disabled = true;
        try {
          const borrados = await limpiarColeccion(parejaId, yo, c);
          aviso(`${ETIQUETA_COLECCION[c]}: ${borrados} registros eliminados.`, 'ok');
        } catch {
          aviso('No se pudo limpiar. Revisa tu conexión.');
        }
        await pintarLimpiezas();
      });

      cont.append(b);
    }
  }

  function pintarAuditoria(eventos: EventoAuditoria[]) {
    const ul = $('lista-auditoria');
    ul.replaceChildren();
    if (eventos.length === 0) {
      const p = document.createElement('li');
      p.className = 'rounded-xl border border-dashed border-borde px-4 py-8 text-center text-sm text-tinta-tenue';
      p.textContent = 'Sin actividad registrada todavía.';
      ul.append(p);
      return;
    }
    for (const e of eventos) {
      const li = document.createElement('li');
      li.className = 'tarjeta px-4 py-3';
      const t = document.createElement('p');
      t.className = 'text-sm font-medium text-tinta';
      t.textContent = `${nombres[e.actor]} · ${e.accion}`;
      const r = document.createElement('p');
      r.className = 'truncate text-xs text-tinta-tenue';
      r.textContent = e.recurso;
      const f = document.createElement('p');
      f.className = 'mt-0.5 text-xs text-tinta-tenue';
      f.textContent = formatearUltimaConexion(e.ocurridoEn);
      li.append(t, r, f);
      ul.append(li);
    }
  }

  // ── Arranque ──────────────────────────────────────────────────────────

  protegerPagina((sesion) => {
    yo = sesion.persona;
    $('guardia').classList.add('hidden');
    $('app').classList.remove('hidden');
    verSeccion('banco');
    marcarJuego();
    opcionesCategoria();
    void recargarBanco();

    for (const b of document.querySelectorAll<HTMLButtonElement>('#secciones button')) {
      b.addEventListener('click', () => {
        const sec = b.dataset.sec ?? 'banco';
        verSeccion(sec);
        if (sec === 'datos') void pintarLimpiezas();
        if (sec === 'progreso') void pintarMetricas();
      });
    }

    for (const b of document.querySelectorAll<HTMLButtonElement>('.juego-tab')) {
      b.addEventListener('click', async () => {
        const nuevo = (b.dataset.juego ?? 'preguntas') as Juego;
        if (nuevo === juego) return;
        juego = nuevo;
        marcarJuego();
        opcionesCategoria();
        await recargarBanco();
      });
    }

    // Buscar mientras se escribe, sin ir a la red: el banco ya está en memoria.
    $('buscador').addEventListener('input', () => { mostradas = PAGINA; pintarBanco(); });
    $('filtro-categoria').addEventListener('change', () => { mostradas = PAGINA; pintarBanco(); });
    $('ver-mas').addEventListener('click', () => { mostradas += PAGINA; pintarBanco(); });

    for (const p of ['a', 'b'] as const) {
      observarNombre(parejaId, p, (n) => { if (n) nombres[p] = n; });
    }

    observarAuditoria(parejaId, pintarAuditoria);
    observarConfig(parejaId, (v) => { ($('cfg-ventana') as HTMLInputElement).value = String(v); });

    // El nivel solo aparece donde significa algo.
    const alternarNivel = (selectId: string, cajaId: string) => {
      const sel = $(selectId) as HTMLSelectElement;
      const sync = () => {
        const on = sel.value === 'subidas_de_tono';
        $(cajaId).classList.toggle('hidden', !on);
        $(cajaId).classList.toggle('flex', on);
      };
      sel.addEventListener('change', sync);
      sync();
    };
    alternarNivel('np-categoria', 'np-nivel-caja');
    alternarNivel('nd-categoria', 'nd-nivel-caja');

    $('tarjeta-preguntas').addEventListener('click', () => void abrirDetalle('preguntas'));
    $('tarjeta-dilemas').addEventListener('click', () => void abrirDetalle('dilemas'));
    $('detalle-cerrar').addEventListener('click', () => { $('detalle').hidden = true; });

    $('sel-todas').addEventListener('click', () => {
      for (const f of detalleFilas) seleccion.add(f.id);
      pintarDetalle();
    });
    $('sel-ninguna').addEventListener('click', () => { seleccion.clear(); pintarDetalle(); });

    $('sel-eliminar').addEventListener('click', async () => {
      const b = $('sel-eliminar') as HTMLButtonElement;
      const n = seleccion.size;
      if (n === 0) return;

      // Doble confirmación: esto retira cartas del banco para siempre.
      if (b.dataset.armado !== 'si') {
        b.dataset.armado = 'si';
        b.textContent = `¿Eliminar ${n}? Pulsa otra vez`;
        setTimeout(() => { b.dataset.armado = ''; actualizarSeleccion(); }, 5000);
        return;
      }
      b.dataset.armado = '';
      b.disabled = true;
      try {
        await retirarDelBanco(parejaId, yo, detalleJuego, [...seleccion]);
        aviso(`${n} eliminadas del banco.`, 'ok');
        seleccion.clear();
        await abrirDetalle(detalleJuego);
        await recargarBanco();
      } catch {
        aviso('No se pudieron eliminar.');
      } finally {
        b.disabled = false;
      }
    });

    $('np-crear').addEventListener('click', async () => {
      aviso(null);
      const texto = ($('np-texto') as HTMLTextAreaElement).value;
      const cat = ($('np-categoria') as HTMLSelectElement).value as CategoriaPregunta;
      const nivel = Number(($('np-nivel') as HTMLSelectElement).value) as Nivel;
      try {
        await crearPregunta(yo, texto, cat, cat === 'subidas_de_tono' ? nivel : 1);
        ($('np-texto') as HTMLTextAreaElement).value = '';
        aviso('Pregunta agregada.', 'ok');
        await recargarBanco();
      } catch (e) {
        aviso(e instanceof ErrorAdmin ? e.message : 'No se pudo agregar.');
      }
    });

    $('nd-crear').addEventListener('click', async () => {
      aviso(null);
      const cat = ($('nd-categoria') as HTMLSelectElement).value as CategoriaDilema;
      const nivel = Number(($('nd-nivel') as HTMLSelectElement).value) as Nivel;
      try {
        await crearDilema(
          yo,
          ($('nd-a') as HTMLInputElement).value,
          ($('nd-b') as HTMLInputElement).value,
          cat,
          cat === 'subidas_de_tono' ? nivel : 1,
        );
        ($('nd-a') as HTMLInputElement).value = '';
        ($('nd-b') as HTMLInputElement).value = '';
        aviso('Dilema agregado.', 'ok');
        await recargarBanco();
      } catch (e) {
        aviso(e instanceof ErrorAdmin ? e.message : 'No se pudo agregar.');
      }
    });

    $('cfg-guardar').addEventListener('click', async () => {
      aviso(null);
      try {
        await guardarVentana(parejaId, Number(($('cfg-ventana') as HTMLInputElement).value));
        aviso('Configuración guardada.', 'ok');
      } catch (e) {
        aviso(e instanceof ErrorAdmin ? e.message : 'No se pudo guardar.');
      }
    });

    $('reiniciar-marcador').addEventListener('click', async () => {
      const b = $('reiniciar-marcador') as HTMLButtonElement;
      if (b.dataset.armado !== 'si') {
        b.dataset.armado = 'si';
        b.textContent = '¿Seguro? Pulsa otra vez';
        setTimeout(() => { b.dataset.armado = ''; b.textContent = 'Reiniciar marcador de organización'; }, 4000);
        return;
      }
      b.dataset.armado = '';
      b.textContent = 'Reiniciar marcador de organización';
      try {
        await reiniciarMarcador(parejaId, yo);
        aviso('Marcador reiniciado a cero.', 'ok');
      } catch {
        aviso('No se pudo reiniciar.');
      }
    });
  });
</script>
