---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout titulo="Perfiles · Nuestro Espacio" encabezado="Perfiles">
  <div id="pestanas" role="tablist" class="mb-5 flex gap-2">
    {
      [
        ['yo', 'Tú'],
        ['pareja', 'Tu pareja'],
        ['nosotros', 'Nosotros'],
      ].map(([v, t]) => (
        <button
          type="button"
          role="tab"
          data-panel={v}
          class="flex-1 rounded-full border border-borde px-3 py-2 text-sm font-medium text-tinta-suave transition"
        >{t}</button>
      ))
    }
  </div>

  {/* ── TU PERFIL (editable) ─────────────────────────────────────────── */}
  <section id="panel-yo" role="tabpanel" class="hidden flex-col gap-4">
    <div class="tarjeta flex flex-col gap-4 px-4 py-5">
      <div>
        <label for="yo-nombre" class="mb-1.5 block text-sm font-medium text-tinta">Tu nombre</label>
        <input id="yo-nombre" type="text" maxlength="40"
          class="w-full rounded-xl border border-borde bg-superficie-alt px-4 py-2.5 text-tinta focus:border-acento focus:outline-none" />
      </div>
      <div>
        <label for="yo-nacimiento" class="mb-1.5 block text-sm font-medium text-tinta">Fecha de nacimiento</label>
        <input id="yo-nacimiento" type="date"
          class="w-full rounded-xl border border-borde bg-superficie-alt px-4 py-2.5 text-tinta focus:border-acento focus:outline-none" />
        <p id="yo-signo" class="mt-1.5 text-sm text-tinta-suave"></p>
      </div>
    </div>

    <div id="yo-listas" class="flex flex-col gap-4"></div>

    <button id="yo-guardar" type="button"
      class="rounded-xl bg-acento px-4 py-3.5 font-medium text-white transition hover:bg-acento-fuerte active:scale-[0.98] disabled:opacity-50">
      <span id="yo-guardar-texto">Guardar mi perfil</span>
    </button>
    <p id="yo-error" role="alert" class="hidden rounded-xl border border-peligro/30 bg-peligro/5 px-4 py-2.5 text-sm text-peligro"></p>
  </section>

  {/* ── PERFIL DE LA PAREJA (solo lectura) ───────────────────────────── */}
  <section id="panel-pareja" role="tabpanel" class="hidden flex-col gap-4">
    <div class="tarjeta px-4 py-5">
      <p id="pareja-nombre" class="text-xl font-semibold text-tinta">…</p>
      <p id="pareja-nacimiento" class="mt-1 text-sm text-tinta-suave"></p>
    </div>
    <div id="pareja-listas" class="flex flex-col gap-4"></div>
    <p class="text-center text-xs text-tinta-tenue">
      Solo tu pareja puede editar esto. Las reglas del servidor lo impiden, no la app.
    </p>
  </section>

  {/* ── NOSOTROS ─────────────────────────────────────────────────────── */}
  <section id="panel-nosotros" role="tabpanel" class="hidden flex-col gap-4">
    <div id="contador" class="tarjeta hidden px-5 py-6 text-center">
      <p class="text-[11px] font-medium tracking-wide text-acento uppercase">Llevamos juntos</p>
      <p id="contador-texto" class="mt-2 text-2xl leading-tight font-semibold text-balance text-tinta"></p>
      <p id="contador-detalle" class="mt-2 text-sm text-tinta-suave"></p>
      <p id="contador-aniversario" class="mt-3 rounded-lg bg-acento-suave px-3 py-2 text-sm font-medium text-acento"></p>
    </div>

    <div class="tarjeta flex flex-col gap-4 px-4 py-5">
      <p class="text-sm font-semibold text-tinta-suave">Fechas memorables</p>
      <div>
        <label for="fecha-salidas" class="mb-1.5 block text-sm text-tinta">Empezamos a salir</label>
        <input id="fecha-salidas" type="date"
          class="w-full rounded-xl border border-borde bg-superficie-alt px-4 py-2.5 text-tinta focus:border-acento focus:outline-none" />
      </div>
      <div>
        <label for="fecha-noviazgo" class="mb-1.5 block text-sm text-tinta">Somos novios desde</label>
        <input id="fecha-noviazgo" type="date"
          class="w-full rounded-xl border border-borde bg-superficie-alt px-4 py-2.5 text-tinta focus:border-acento focus:outline-none" />
      </div>
      <p class="text-xs text-tinta-tenue">
        El contador usa la primera de las dos que esté puesta.
      </p>
    </div>

    <div class="tarjeta px-4 py-5">
      <p class="mb-2 text-sm font-semibold text-tinta-suave">Hitos</p>
      <ul id="lista-hitos" class="mb-3 flex flex-col gap-2"></ul>
      <div class="flex gap-2">
        <input id="hito-titulo" type="text" maxlength="60" placeholder="Primer viaje juntos"
          class="min-w-0 flex-1 rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none" />
        <input id="hito-fecha" type="date"
          class="shrink-0 rounded-lg border border-borde bg-superficie-alt px-3 py-2.5 text-sm text-tinta focus:border-acento focus:outline-none" />
      </div>
      <button id="hito-agregar" type="button"
        class="mt-2 w-full rounded-lg border border-acento px-3 py-2.5 text-sm font-medium text-acento transition hover:bg-acento-suave">
        Agregar hito
      </button>
    </div>

    <div class="tarjeta px-4 py-5">
      <p class="mb-2 text-sm font-semibold text-tinta-suave">Intereses en común</p>
      <div id="comunes" class="flex flex-wrap gap-2"></div>
      <p id="comunes-vacio" class="text-sm text-tinta-tenue">
        Se calculan solos comparando los gustos y hobbies de los dos.
      </p>
    </div>

    <button id="nosotros-guardar" type="button"
      class="rounded-xl bg-acento px-4 py-3.5 font-medium text-white transition hover:bg-acento-fuerte active:scale-[0.98] disabled:opacity-50">
      <span id="nosotros-guardar-texto">Guardar</span>
    </button>
    <p id="nosotros-error" role="alert" class="hidden rounded-xl border border-peligro/30 bg-peligro/5 px-4 py-2.5 text-sm text-peligro"></p>
  </section>
</AppLayout>

<script>
  import { protegerPagina } from '../domain/identidad/guardia';
  import {
    observarPerfil, guardarPerfil, observarPerfilConjunto, guardarPerfilConjunto,
    interesesComunes, validarEntradaLista, SECCIONES_PERFIL, PERFIL_VACIO, CONJUNTO_VACIO,
    ErrorPerfil, type Perfil, type PerfilConjunto, type CampoLista, type Hito,
  } from '../domain/perfiles/perfilesService';
  import { calcularTiempoJuntos, fechaLarga, hoyEnSantiago } from '../domain/perfiles/tiempoJuntos';
  import { signoLegible, edadDe } from '@shared/zodiaco';
  import { otraPersona, type Persona } from '@shared/enums';
  import { ENV } from '../config/env';

  const $ = (id: string) => document.getElementById(id)!;
  const parejaId = ENV.PUBLIC_PAREJA_ID;

  let yoPersona: Persona = 'a';
  let miPerfil: Perfil = { ...PERFIL_VACIO };
  let suPerfil: Perfil = { ...PERFIL_VACIO };
  let conjunto: PerfilConjunto = { ...CONJUNTO_VACIO };
  /** Copia editable: no se pisa mientras el usuario escribe. */
  let borrador: Perfil = { ...PERFIL_VACIO };
  let editando = false;

  function verPanel(cual: string) {
    for (const p of ['yo', 'pareja', 'nosotros']) {
      const s = $(`panel-${p}`);
      s.classList.toggle('hidden', p !== cual);
      s.classList.toggle('flex', p === cual);
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>('#pestanas button')) {
      const on = b.dataset.panel === cual;
      b.classList.toggle('border-acento', on);
      b.classList.toggle('bg-acento-suave', on);
      b.classList.toggle('text-acento', on);
      b.classList.toggle('text-tinta-suave', !on);
      b.setAttribute('aria-selected', String(on));
    }
  }

  /** Chip de una lista. Todo con createElement: nunca innerHTML. */
  function chip(texto: string, alQuitar?: () => void): HTMLElement {
    const el = document.createElement('span');
    el.className =
      'inline-flex items-center gap-1.5 rounded-full bg-superficie-alt px-3 py-1.5 text-sm text-tinta';
    const t = document.createElement('span');
    t.textContent = texto;
    el.appendChild(t);
    if (alQuitar) {
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'text-tinta-tenue transition hover:text-peligro';
      x.setAttribute('aria-label', `Quitar ${texto}`);
      x.textContent = '✕';
      x.addEventListener('click', alQuitar);
      el.appendChild(x);
    }
    return el;
  }

  /**
   * Título de sección. Existe porque veintitrés campos en una lista plana son
   * ilegibles en un teléfono: agrupados por tema, cada bloque cabe de una
   * mirada y se puede saltar el que no interesa.
   */
  /**
   * "Nació el 3 de julio de 1996 · 30 años · ♋ Cáncer · Agua".
   *
   * El signo y la edad se derivan de la fecha; no son campos guardados. Así no
   * pueden contradecirla, que es lo que pasa siempre que se deja elegir el
   * signo en un desplegable aparte.
   */
  function descripcionNacimiento(fecha: string | undefined): string {
    if (!fecha) return '';
    const partes = [`Nació el ${fechaLarga(fecha)}`];
    const edad = edadDe(fecha, hoyEnSantiago());
    if (edad !== null) partes.push(`${edad} años`);
    const signo = signoLegible(fecha);
    if (signo) partes.push(signo);
    return partes.join(' · ');
  }

  function encabezado(emoji: string, titulo: string): HTMLElement {
    const h = document.createElement('h3');
    h.className =
      'mt-5 mb-1 flex items-center gap-2 text-xs font-semibold tracking-wide text-tinta-tenue uppercase first:mt-0';
    const e = document.createElement('span');
    e.setAttribute('aria-hidden', 'true');
    e.textContent = emoji;
    const t = document.createElement('span');
    t.textContent = titulo;
    h.append(e, t);
    return h;
  }

  function pintarListasEditables() {
    const cont = $('yo-listas');
    cont.replaceChildren();

    for (const seccion of SECCIONES_PERFIL) {
    cont.appendChild(encabezado(seccion.emoji, seccion.titulo));
    for (const { campo: clave, etiqueta, ejemplo: ayuda } of seccion.campos) {
      const caja = document.createElement('div');
      caja.className = 'tarjeta px-4 py-4';

      const titulo = document.createElement('p');
      titulo.className = 'text-sm font-semibold text-tinta';
      titulo.textContent = etiqueta;
      caja.appendChild(titulo);

      if (ayuda) {
        const sub = document.createElement('p');
        sub.className = 'mb-2 text-xs text-tinta-tenue';
        sub.textContent = ayuda;
        caja.appendChild(sub);
      }

      const chips = document.createElement('div');
      chips.className = 'mb-2 flex flex-wrap gap-2';
      const valores: string[] = borrador[clave] ?? [];
      for (const v of valores) {
        chips.appendChild(chip(v, () => {
          borrador[clave] = valores.filter((x: string) => x !== v);
          editando = true;
          pintarListasEditables();
        }));
      }
      if (valores.length === 0) {
        const vacio = document.createElement('p');
        vacio.className = 'text-xs text-tinta-tenue';
        vacio.textContent = 'Nada todavía.';
        chips.appendChild(vacio);
      }
      caja.appendChild(chips);

      const fila = document.createElement('div');
      fila.className = 'flex gap-2';
      const input = document.createElement('input');
      input.type = 'text';
      input.maxLength = 60;
      input.placeholder = 'Agregar…';
      input.className =
        'min-w-0 flex-1 rounded-lg border border-borde bg-superficie-alt px-3 py-2 text-sm text-tinta placeholder:text-tinta-tenue focus:border-acento focus:outline-none';

      const agregar = () => {
        try {
          const v = validarEntradaLista(input.value);
          const actuales: string[] = borrador[clave] ?? [];
          if (!actuales.some((x: string) => x.toLowerCase() === v.toLowerCase())) {
            borrador[clave] = [...actuales, v];
          }
          input.value = '';
          editando = true;
          error('yo', null);
          pintarListasEditables();
        } catch (e) {
          error('yo', e instanceof ErrorPerfil ? e.message : 'No se pudo agregar.');
        }
      };

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); agregar(); }
      });

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'shrink-0 rounded-lg border border-borde px-3 py-2 text-sm text-tinta-suave transition hover:border-acento hover:text-acento';
      btn.textContent = 'Añadir';
      btn.addEventListener('click', agregar);

      fila.append(input, btn);
      caja.appendChild(fila);
      cont.appendChild(caja);
    }
    }
  }

  function pintarPerfilPareja() {
    $('pareja-nombre').textContent = suPerfil.nombre || 'Todavía no ha completado su perfil';
    $('pareja-nacimiento').textContent = descripcionNacimiento(suPerfil.fechaNacimiento);

    const cont = $('pareja-listas');
    cont.replaceChildren();

    for (const seccion of SECCIONES_PERFIL) {
    // Una sección entera sin nada escrito no se pinta: en el perfil ajeno,
    // seis encabezados con "Nada todavía" debajo no informan de nada.
    if (!seccion.campos.some((c) => (suPerfil[c.campo] ?? []).length > 0)) continue;
    cont.appendChild(encabezado(seccion.emoji, seccion.titulo));

    for (const { campo: clave, etiqueta } of seccion.campos) {
      const valores: string[] = suPerfil[clave] ?? [];
      if (valores.length === 0) continue;
      const caja = document.createElement('div');
      caja.className = 'tarjeta px-4 py-4';
      const t = document.createElement('p');
      t.className = 'mb-2 text-sm font-semibold text-tinta';
      t.textContent = etiqueta;
      caja.appendChild(t);
      const chips = document.createElement('div');
      chips.className = 'flex flex-wrap gap-2';
      if (valores.length === 0) {
        const v = document.createElement('p');
        v.className = 'text-xs text-tinta-tenue';
        v.textContent = 'Nada todavía.';
        chips.appendChild(v);
      } else {
        // Las alergias se destacan: es el dato con consecuencias reales.
        for (const v of valores) {
          const c = chip(v);
          if (clave === 'alergias') c.className = c.className.replace('bg-superficie-alt', 'bg-peligro/10 text-peligro');
          chips.appendChild(c);
        }
      }
      caja.appendChild(chips);
      cont.appendChild(caja);
    }
    }
  }

  function pintarContador() {
    const desde = conjunto.fechaInicioSalidas ?? conjunto.fechaNoviazgo;
    const caja = $('contador');
    const t = desde ? calcularTiempoJuntos(desde) : null;

    caja.classList.toggle('hidden', !t);
    if (!t || !desde) return;

    $('contador-texto').textContent = t.texto;
    $('contador-detalle').textContent = `${t.totalDias.toLocaleString('es-CL')} días desde el ${fechaLarga(desde)}`;
    $('contador-aniversario').textContent =
      t.paraAniversario === 0
        ? '🎉 ¡Hoy es el aniversario!'
        : t.paraAniversario === 1
          ? 'Mañana es el aniversario'
          : `Faltan ${t.paraAniversario} días para el aniversario`;
  }

  function pintarHitos() {
    const ul = $('lista-hitos');
    ul.replaceChildren();
    const ordenados = [...conjunto.hitos].sort((a, b) => a.fecha.localeCompare(b.fecha));
    for (const h of ordenados) {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-3 rounded-lg bg-superficie-alt px-3 py-2';
      const txt = document.createElement('div');
      txt.className = 'min-w-0 flex-1';
      const t = document.createElement('p');
      t.className = 'truncate text-sm font-medium text-tinta';
      t.textContent = h.titulo;
      const f = document.createElement('p');
      f.className = 'text-xs text-tinta-tenue';
      f.textContent = fechaLarga(h.fecha);
      txt.append(t, f);
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'shrink-0 text-tinta-tenue transition hover:text-peligro';
      x.setAttribute('aria-label', `Quitar ${h.titulo}`);
      x.textContent = '✕';
      x.addEventListener('click', () => {
        conjunto.hitos = conjunto.hitos.filter((y) => y.id !== h.id);
        pintarHitos();
      });
      li.append(txt, x);
      ul.appendChild(li);
    }
    if (ordenados.length === 0) {
      const p = document.createElement('p');
      p.className = 'text-xs text-tinta-tenue';
      p.textContent = 'Todavía no hay hitos.';
      ul.appendChild(p);
    }
  }

  function pintarComunes() {
    const comunes = interesesComunes(miPerfil, suPerfil);
    const cont = $('comunes');
    cont.replaceChildren();
    $('comunes-vacio').classList.toggle('hidden', comunes.length > 0);
    for (const c of comunes) {
      const el = chip(c);
      el.className = el.className.replace('bg-superficie-alt', 'bg-salvia-suave text-salvia');
      cont.appendChild(el);
    }
  }

  function error(panel: 'yo' | 'nosotros', texto: string | null) {
    const el = $(`${panel}-error`);
    el.textContent = texto ?? '';
    el.classList.toggle('hidden', !texto);
  }

  protegerPagina((sesion) => {
    yoPersona = sesion.persona;
    $('guardia').classList.add('hidden');
    $('app').classList.remove('hidden');
    verPanel('yo');

    for (const b of document.querySelectorAll<HTMLButtonElement>('#pestanas button')) {
      b.addEventListener('click', () => verPanel(b.dataset.panel ?? 'yo'));
    }

    observarPerfil(parejaId, yoPersona, (p) => {
      miPerfil = p;
      // No se pisa lo que el usuario está escribiendo ahora mismo.
      if (!editando) {
        borrador = structuredClone(p);
        ($('yo-nombre') as HTMLInputElement).value = p.nombre;
        ($('yo-nacimiento') as HTMLInputElement).value = p.fechaNacimiento ?? '';
        $('yo-signo').textContent = descripcionNacimiento(p.fechaNacimiento);
        pintarListasEditables();
      }
      pintarComunes();
    });

    observarPerfil(parejaId, otraPersona(yoPersona), (p) => {
      suPerfil = p;
      pintarPerfilPareja();
      pintarComunes();
    });

    observarPerfilConjunto(parejaId, (c) => {
      conjunto = c;
      ($('fecha-salidas') as HTMLInputElement).value = c.fechaInicioSalidas ?? '';
      ($('fecha-noviazgo') as HTMLInputElement).value = c.fechaNoviazgo ?? '';
      pintarContador();
      pintarHitos();
    });

    for (const id of ['yo-nombre', 'yo-nacimiento']) {
      $(id).addEventListener('input', () => { editando = true; });
    }

    // El signo se recalcula mientras se escribe la fecha: es una consecuencia
    // de ella, y verlo cambiar deja claro que no hay nada que elegir aparte.
    $('yo-nacimiento').addEventListener('change', () => {
      const v = ($('yo-nacimiento') as HTMLInputElement).value;
      $('yo-signo').textContent = descripcionNacimiento(v || undefined);
      editando = true;
    });

    $('yo-guardar').addEventListener('click', async () => {
      error('yo', null);
      const btn = $('yo-guardar') as HTMLButtonElement;
      btn.disabled = true;
      $('yo-guardar-texto').textContent = 'Guardando…';
      try {
        const nacimiento = ($('yo-nacimiento') as HTMLInputElement).value;
        await guardarPerfil(parejaId, yoPersona, {
          ...borrador,
          nombre: ($('yo-nombre') as HTMLInputElement).value,
          ...(nacimiento ? { fechaNacimiento: nacimiento } : {}),
        });
        editando = false;
        $('yo-guardar-texto').textContent = 'Guardado ✓';
        setTimeout(() => { $('yo-guardar-texto').textContent = 'Guardar mi perfil'; }, 1800);
      } catch (e) {
        error('yo', e instanceof ErrorPerfil ? e.message : 'No se pudo guardar.');
        $('yo-guardar-texto').textContent = 'Guardar mi perfil';
      } finally {
        btn.disabled = false;
      }
    });

    $('hito-agregar').addEventListener('click', () => {
      const titulo = ($('hito-titulo') as HTMLInputElement).value.trim();
      const fecha = ($('hito-fecha') as HTMLInputElement).value;
      error('nosotros', null);
      if (!titulo || !fecha) { error('nosotros', 'El hito necesita título y fecha.'); return; }
      if (/[<>]/.test(titulo)) { error('nosotros', 'El título no puede llevar < ni >.'); return; }
      conjunto.hitos = [...conjunto.hitos, { id: crypto.randomUUID().slice(0, 8), titulo, fecha } as Hito];
      ($('hito-titulo') as HTMLInputElement).value = '';
      pintarHitos();
    });

    $('nosotros-guardar').addEventListener('click', async () => {
      error('nosotros', null);
      const btn = $('nosotros-guardar') as HTMLButtonElement;
      btn.disabled = true;
      $('nosotros-guardar-texto').textContent = 'Guardando…';
      try {
        await guardarPerfilConjunto(
          parejaId, yoPersona,
          {
            fechaInicioSalidas: ($('fecha-salidas') as HTMLInputElement).value || null,
            fechaNoviazgo: ($('fecha-noviazgo') as HTMLInputElement).value || null,
            hitos: conjunto.hitos,
          },
          interesesComunes(miPerfil, suPerfil),
        );
        $('nosotros-guardar-texto').textContent = 'Guardado ✓';
        setTimeout(() => { $('nosotros-guardar-texto').textContent = 'Guardar'; }, 1800);
      } catch (e) {
        error('nosotros', e instanceof ErrorPerfil ? e.message : 'No se pudo guardar.');
        $('nosotros-guardar-texto').textContent = 'Guardar';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
