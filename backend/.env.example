# ═══════════════════════════════════════════════════════════════════════════
#  PLANTILLA — copiar a .env.qa y .env.prod (ninguno de los dos se versiona)
#
#      cp backend/.env.example backend/.env.qa
#      cp backend/.env.example backend/.env.prod
#
#  ⚠ El repositorio es PÚBLICO. Si un valor real llega a este archivo, es una
#     filtración. Aquí solo van claves vacías o de ejemplo.
# ═══════════════════════════════════════════════════════════════════════════

# Identificador lógico del espacio. Debe coincidir con PUBLIC_PAREJA_ID del
# frontend: es la frontera anti-IDOR de todo el sistema.
PAREJA_ID=pareja_principal

# URL de Realtime Database (Consola Firebase → Realtime Database → arriba)
# Ejemplo: https://nuestro-espacio-qa-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# ── CREDENCIAL DEL ADMIN SDK ───────────────────────────────────────────────
# Ruta al Service Account descargado. DEBE vivir en backend/secrets/, que está
# en .gitignore. Nunca lo muevas fuera de ahí.
#
# Esta credencial IGNORA todas las Security Rules: puede leer y borrar todo.
# Es el único secreto de verdad del proyecto.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa-qa.json

# En GitHub Actions no se usa la ruta sino el JSON completo, que llega por un
# GitHub Secret. No definas esta variable en tu máquina.
# FIREBASE_SERVICE_ACCOUNT=
